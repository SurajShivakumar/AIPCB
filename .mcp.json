{
  "mcpServers": {
    "kicad": {
      "command": "node",
      "args": ["vendor/KiCAD-MCP-Server/dist/index.js"],
      "env": {
        "LOG_LEVEL": "error",
        "KICAD_AUTO_LAUNCH": "false",
        "KICAD_BACKEND": "auto",
        "KICAD_INTERACTIVE_SCHEMATIC": "true"
      }
    },
    "copilot": {
      "command": ".venv/Scripts/python.exe",
      "args": ["-m", "copilot.server"],
      "env": {
        "PYTHONIOENCODING": "utf-8"
      }
    }
  }
}
